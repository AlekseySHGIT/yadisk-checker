# Скопируйте этот файл в .env и заполните (на Vercel: Settings → Environment Variables).
# Приложение регистрируется на https://oauth.yandex.ru/client/new
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Любая длинная случайная строка: ключ шифрования cookie с токеном
COOKIE_SECRET=

# Необязательно:
# CHECK_TIMEOUT_MS=8000    # сколько ждать ответа сервера скачивания
# YANDEX_REDIRECT_URI=     # если адрес callback нужно задать явно
